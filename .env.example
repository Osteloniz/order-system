# Neon (Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Para producao, crie um arquivo local .env.prod com as credenciais da branch de producao do Neon.

# NextAuth
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Para testar checkout Asaas localmente, APP_URL precisa apontar para uma URL publica temporaria do tunel.
# Para testar Mercado Pago localmente, use tambem uma URL publica em APP_URL para retorno e webhook.
ONLINE_PAYMENT_GATEWAY="MERCADO_PAGO"
# Se a sua chave do Asaas comecar com $, escape no .env local como \$
ASAAS_ENV="sandbox"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
ASAAS_CHECKOUT_EXPIRY_MINUTES="60"
MERCADO_PAGO_PUBLIC_KEY=""
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
ADMIN_ACCESS_KEY=""
# Lista somente para bootstrap/migracao de administradores legados. Novos acessos usam convite do master.
ADMIN_ALLOWED_EMAILS="admin1@exemplo.com,admin2@exemplo.com"
ADMIN_USER_LIMIT="10"
# Chave AES-256 em Base64. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=""
TOKEN_PEPPER=""
BCRYPT_ROUNDS="12"
INVITE_EXPIRY_HOURS="24"
# Envio transacional dos convites. AUTH_EMAIL_FROM deve usar dominio validado no provedor.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Brookie Pregiato <acessos@seu-dominio.com>"
LOG_LEVEL="info"
ENABLE_OPERATION_LOGS="true"
LOG_OPERATION_RETENTION_DAYS="90"
AUTH_AUDIT_RETENTION_DAYS="180"

